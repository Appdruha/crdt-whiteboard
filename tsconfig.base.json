{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@crdt-demo/shared": [
        "./shared/src/index.ts"
      ],
      "@crdt-demo/shared/*": [
        "./shared/src/*"
      ],
      "@crdt-demo/engine": [
        "./engine/src/index.ts"
      ],
      "@crdt-demo/engine/*": [
        "./engine/src/*"
      ]
    }
  }
}

